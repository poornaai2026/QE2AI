# LLM Providers (Set at least one)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEFAULT_MODEL_PROVIDER=gemini # or openai
DEFAULT_MODEL_NAME=gemini-2.5-flash # or gpt-4o

# Atlassian Integrations (Optional - mock fallback available)
JIRA_URL=https://your-domain.atlassian.net
JIRA_USERNAME=your-email@domain.com
JIRA_API_TOKEN=your_jira_api_token
CONFLUENCE_URL=https://your-domain.atlassian.net/wiki

# QE Execution Settings
TEST_WORKSPACE_DIR=workspace/tests
REPORT_WORKSPACE_DIR=workspace/reports
MAX_HEALING_ATTEMPTS=3
KARATE_EXECUTION_MODE=mock # 'cli' (requires mvn/karate jar) or 'mock' (Python HTTP engine)
