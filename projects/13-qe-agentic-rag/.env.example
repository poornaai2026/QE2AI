# ==============================================================================
# Agentic QE Platform Environment Configuration
# ==============================================================================

# LLM Providers (Optional: system runs in realistic simulation/hybrid mode if blank)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Pinecone Vector DB (Optional: system uses local FAISS vector store if blank)
PINECONE_API_KEY=
PINECONE_INDEX=qe-enterprise-rag
PINECONE_ENVIRONMENT=us-east-1

# Platform Configuration
PLATFORM_PORT=8000
TARGET_APP_PORT=8080
MCP_SERVER_PORT=8001
AI_QUALITY_GATE_THRESHOLD=0.85
MAX_REGENERATION_ATTEMPTS=2
HEADLESS_BROWSER=true
